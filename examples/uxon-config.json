{
  "runtime_user": "wes-agent",
  "default_launch_mode": "fixed",
  "enable_all_users_list": false,
  "session_prefix": "uxon-",
  "legacy_session_prefixes": [],
  "allowed_roots": ["/srv/projects"],
  "session_users": ["wes-agent"],
  "new_project_root": "/srv/projects",
  "repeat_noninteractive_mode": "fail",
  "tmux_socket_template": "/tmp/uxon-{user}.sock",
  "agents": {
    "enabled": ["claude"],
    "default": "claude",
    "claude": { "default_args": [] },
    "codex":  { "default_args": [] },
    "cursor": { "default_args": [] }
  },
  "launch_user_by_caller": {},
  "container": {
    "enabled": false,
    "name_template": "uxon-{user}-{project_slug}",
    "exec_template": ["docker", "exec", "-w", "{dir}", "-i", "{name}"],
    "is_running_cmd": ["docker", "top", "{name}"],
    "exists_cmd": ["docker", "container", "inspect", "{name}"],
    "on_missing": "off",
    "on_missing_mode": "prompt",
    "start_template": ["docker", "start", "{name}"],
    "create_template": ["docker", "compose", "up", "-d"],
    "path_map": { "/srv/projects": "/work" }
  }
}
