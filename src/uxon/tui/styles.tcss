/* uxon TUI — root stylesheet.
 *
 * Tokens pinned per T0c: textual 8.x provides $error / $warning /
 * $text-muted / $accent / $surface / $boost. Renaming requires a
 * follow-up across every .tcss in this package.
 */

/* Theme tokens (aliases over textual built-ins). */
$uxon-attached: green;
$uxon-danger: $error;
$uxon-sudo: $warning;
$uxon-dim: $text-muted;
$uxon-hot: red;      /* CPU hot */
$uxon-warm: yellow;  /* CPU warm */

Screen {
    layout: vertical;
}

Header {
    dock: top;
}

Footer {
    dock: bottom;
    background: $panel;
}

/* ── MainScreen ──────────────────────────────────────────────────── */

#main-body {
    width: 1fr;
    height: 1fr;
}

.empty-note {
    color: $uxon-dim;
    padding: 0 1;
    margin-top: 1;
    text-style: italic;
}

/* ── ActionRow ───────────────────────────────────────────────────── */

/* One flat single-line visual for every action row — the launch stack
 * at the top and the superuser rows (Settings / Kill-ALL) at the
 * bottom. styles.tcss takes precedence over the widget's DEFAULT_CSS
 * (CSS_PATH on the App), so the look lives here as the single source
 * of truth; keep it in lockstep with ActionRow.DEFAULT_CSS. */

ActionRow {
    width: 1fr;
    height: 1;
    padding: 0 1;
    content-align: left middle;
    background: transparent;
}

ActionRow:focus {
    background: $accent 30%;
    text-style: bold;
}

ActionRow:hover {
    background: $boost;
}

ActionRow.-disabled {
    color: $uxon-dim;
    text-style: dim;
}

ActionRow.destructive,
#action-kill-all-global {
    color: $uxon-danger;
}

#action-settings {
    color: $uxon-sudo;
    /* One blank line separates the superuser block from the session
       block above. Margin (not a header widget): it vanishes with the
       row when ``display`` hides the block for non-super sessions. */
    margin-top: 1;
}

/* ── SessionListView ─────────────────────────────────────────────── */

/* Width / height come from :class:`SessionListView` ``DEFAULT_CSS``
 * (the widget's own single source of truth). Per-cell colour
 * (attached green, CPU hot/warm, sudo-only highlights), block hue,
 * zebra and the cursor highlight are painted by the widget's
 * ``render_line`` (Line API) from the ``dashboard/columns.py``
 * formatters + the block-meta map, so no class-bound rules are needed
 * here. The margin separates the session block (tab strip / table)
 * from the action stack above with exactly one blank line. */

SessionListView {
    margin-top: 1;
}

/* ── HostTabStrip ───────────────────────────────────────────────── */

HostTabStrip {
    margin-top: 1;
}

/* The compact host bar renders exactly ``lines[:1]`` — pin it to one row
   so a steady-tick content swap is a repaint, never a relayout (AC7). */
#host-status-compact {
    height: 1;
}

/* ── Modals (ConfirmYesNo, ConfirmPhrase, Permissions, etc.) ─────── */

ModalScreen {
    align: center middle;
}

.prompt, .title {
    text-style: bold;
    margin-bottom: 1;
}

.prompt {
    color: $uxon-danger;
}

/* Phrase modals get the heavier danger border. */
ConfirmPhrase > Vertical {
    border: round $uxon-danger;
}

.buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}

Button {
    margin: 0 1;
}

/* ── SearchBar ──────────────────────────────────────────────────── */

SearchBar {
    margin-top: 1;
    margin-bottom: 0;
}
